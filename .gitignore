# ---------------------------------------------------------------
# AfterHours Revenue — .gitignore
# See https://help.github.com/articles/ignoring-files/
# ---------------------------------------------------------------

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
/dist

# Caches
.turbo
.swc/
.eslintcache
*.tsbuildinfo
next-env.d.ts

# Testing
/coverage

# Local data store (audit-form lead capture — see src/app/api/audit)
/data/leads.local.json

# Environment variables — never commit secrets (.env.example is allowed)
.env*
!.env.example

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment
.vercel

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Claude Code (keep shared launch config; ignore local-only settings)
.claude/settings.local.json

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.pem
